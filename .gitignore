# Editor directories and files.
#
# .vscode/* is ignored so personal preferences stay personal, but these three
# are project configuration rather than taste: without settings.json Tailwind
# IntelliSense cannot see this codebase's className conditionals, the CSS
# language server flags every @tailwind as an error, and my.json renders as
# boxes. Shared, so nobody has to rediscover them.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# local environment
.env
.env.local

# preview build output
dist-preview
