# ─────────────────────────────────────────────────────────────────────────────
# Optical Solution — attendance app environment
#
# Copy to `.env` and fill in from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration
#
# None of these are secrets. Everything prefixed VITE_ is compiled into the
# client bundle and is visible to anyone who opens devtools — which is fine,
# because Firebase web config is public by design. The security boundary is
# firestore.rules plus the Cloud Functions, never these values.
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Only needed if you wire up Firebase Analytics — the attendance app
# deliberately does not. Analytics on a staff kiosk would be recording
# employees' movements through a screen they are required to use, which is a
# different thing from measuring shoppers on the storefront.
VITE_FIREBASE_MEASUREMENT_ID=

# Region the callable functions are deployed to.
VITE_FIREBASE_REGION=asia-southeast1

# Public-IP echo service used by the client-side network check. Any endpoint
# returning {"ip": "..."} or a bare address works. This check is advisory — the
# binding one is the request IP the Cloud Function observes.
VITE_IP_ECHO_URL=https://api.ipify.org?format=json

# ─── DEVELOPMENT ONLY ────────────────────────────────────────────────────────
# Lets the app run before the Cloud Functions are deployed: punches are written
# straight from the browser (tagged verifiedBy: 'client-unverified') and the
# branch PIN is compared locally. There is NO identity verification on this
# path. Leave it unset in any environment real people use.
#
# VITE_ALLOW_CLIENT_PUNCH=true
# VITE_DEV_BRANCH_PIN=1234
